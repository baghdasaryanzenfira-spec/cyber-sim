# Copy to .env and replace every "change-me" value. Never commit .env.

# ---- Database ----
POSTGRES_DB=cybersim
POSTGRES_USER=cybersim
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# ---- Security ----
# At least 32 characters; generate e.g. with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-characters
JWT_EXPIRATION_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Demo accounts (created only if the passwords are set) ----
APP_DEMO_DATA_ENABLED=true
DEMO_ADMIN_EMAIL=admin@cybersim.local
DEMO_ADMIN_PASSWORD=change-me
DEMO_STUDENT_EMAIL=student@cybersim.local
DEMO_STUDENT_PASSWORD=change-me

# ---- AI ----
# mock = offline deterministic tutor (no key needed); claude = Claude API
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=low
AI_TIMEOUT_SECONDS=30

# ---- Ports ----
BACKEND_PORT=8080
FRONTEND_PORT=3000
